---
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL;
---

<Base>
  <main id="top">
    <section class="hero" aria-label="ARQAX Arquitectura">
      <div class="hero__stage">
        <div class="hero__canvas hero__canvas--back" aria-hidden="true">
          <img class="hero__back" src={`${base}hero-back.png`} alt="" draggable="false" />
        </div>

        <div class="hero__canvas hero__canvas--front" aria-hidden="true">
          <img class="hero__front" src={`${base}hero-front.png`} alt="" draggable="false" />
        </div>

        <div class="hero__shade" aria-hidden="true"></div>

        <nav class="hero-nav" aria-label="Navegación principal">
          <a href="#proyectos">Proyectos</a>
          <a href="#estudio">Estudio</a>
          <a href="#contacto">Contacto</a>
        </nav>

        <div class="hero__identity">
          <span class="hero__logo-reveal">
            <img class="hero__logo" src={`${base}arqax-logo.svg`} alt="ARQAX Arquitectura" />
          </span>
        </div>

        <div class="hero__copy">
          <div class="hero__copy-reveal">
            <h1>Diseños que impactan</h1>
            <p>
              Estudio de arquitectura. Identidad que construye confianza, diseña
              experiencias y transforma espacios.
            </p>
          </div>
        </div>

        <div class="scroll-cue" aria-hidden="true">
          <span>Descubre</span>
          <i></i>
        </div>
      </div>
    </section>

    <section class="next-chapter" id="proyectos">
      <header class="next-chapter__head">
        <p>ARQAX · Arquitectura</p>
        <h2>Proyectos destacados</h2>
      </header>
    </section>
    <span id="estudio" class="anchor-target"></span>

    <section class="contact" id="contacto">
      <div class="contact__inner reveal">
        <div class="contact__intro">
          <p class="contact__eyebrow">Contacto</p>
          <h2 class="contact__title">Hablemos de tu próximo proyecto</h2>
          <p class="contact__lead">
            Cuéntanos tu idea y agendemos una primera conversación. Cada espacio
            comienza con un diálogo.
          </p>
          <p class="contact__note">Respondemos en 24 – 48 horas</p>
        </div>

        <form class="contact__form" id="contact-form" novalidate>
          <!-- Web3Forms: reemplaza el valor por tu access key de https://web3forms.com -->
          <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
          <input type="hidden" name="subject" value="Nuevo mensaje de contacto — ARQAX" />
          <input type="hidden" name="from_name" value="ARQAX Arquitectura" />
          <input
            type="checkbox"
            name="botcheck"
            class="contact__honeypot"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <div class="field">
            <label for="cf-name">Nombre</label>
            <input
              id="cf-name"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder="Tu nombre"
            />
          </div>

          <div class="field">
            <label for="cf-email">Correo electrónico</label>
            <input
              id="cf-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="tu@correo.com"
            />
          </div>

          <div class="field">
            <label for="cf-phone">
              Teléfono <span class="field__opt">(opcional)</span>
            </label>
            <input
              id="cf-phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              placeholder="+52 55 0000 0000"
            />
          </div>

          <div class="field">
            <label for="cf-message">Mensaje</label>
            <textarea
              id="cf-message"
              name="message"
              rows="4"
              required
              placeholder="Cuéntanos sobre tu proyecto…"></textarea>
          </div>

          <button type="submit" class="contact__submit">Enviar mensaje</button>
          <p class="contact__status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>
</Base>

<script>
  const clamp = (value: number, min: number, max: number) =>
    Math.min(Math.max(value, min), max);

  const hero = document.querySelector<HTMLElement>(".hero");

  if (hero) {
    let frame = 0;

    const updateProgress = () => {
      frame = 0;
      const rect = hero.getBoundingClientRect();
      const scrollableDistance = Math.max(rect.height - window.innerHeight, 1);
      const progress = clamp(-rect.top / scrollableDistance, 0, 1);
      hero.style.setProperty("--scroll-progress", progress.toFixed(4));
    };

    const requestUpdate = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(updateProgress);
    };

    updateProgress();
    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate);
  }

  // Reveal-on-scroll for elements marked with .reveal
  const revealTargets = document.querySelectorAll<HTMLElement>(".reveal");
  if (revealTargets.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.18 },
    );
    revealTargets.forEach((el) => io.observe(el));
  }

  // Contact form → Web3Forms (AJAX)
  const form = document.querySelector<HTMLFormElement>("#contact-form");

  if (form) {
    const status = form.querySelector<HTMLParagraphElement>(".contact__status");
    const submit = form.querySelector<HTMLButtonElement>(
      "button[type=submit]",
    );

    const setStatus = (message: string, state: string) => {
      if (!status) return;
      status.textContent = message;
      status.className = `contact__status is-${state}`;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const accessKey = (
        form.querySelector<HTMLInputElement>("[name=access_key]")?.value ?? ""
      ).trim();
      if (!accessKey || accessKey === "YOUR_WEB3FORMS_ACCESS_KEY") {
        setStatus(
          "El formulario aún no está configurado. Falta la access key de Web3Forms.",
          "error",
        );
        return;
      }

      if (submit) submit.disabled = true;
      setStatus("Enviando…", "sending");

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
        });
        const result = await response.json();

        if (response.ok && result.success) {
          setStatus(
            "¡Gracias! Tu mensaje fue enviado. Te responderemos pronto.",
            "success",
          );
          form.reset();
        } else {
          setStatus(
            result.message ?? "No se pudo enviar. Inténtalo de nuevo.",
            "error",
          );
        }
      } catch {
        setStatus(
          "Error de conexión. Inténtalo de nuevo más tarde.",
          "error",
        );
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  }
</script>
