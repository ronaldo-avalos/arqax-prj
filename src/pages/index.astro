---
import Base from "../layouts/Base.astro";
import { projects, projectUrl, shotSrc, shotSrcset } from "../data/projects";

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---


<Base>
  <main id="top">
    <section class="hero" aria-label="ARQAX Arquitectura">
      <div class="hero__stage">
        <div class="hero__canvas hero__canvas--back" aria-hidden="true">
          <img class="hero__back" src={`${base}hero-back.png`} alt="" draggable="false" />
        </div>

        <div class="hero__canvas hero__canvas--front" aria-hidden="true">
          <img class="hero__front" src={`${base}hero-front.png`} alt="" draggable="false" />
        </div>

        <div class="hero__shade" aria-hidden="true"></div>

        <nav class="hero-nav" aria-label="Navegación principal">
          <a href="#proyectos">Proyectos</a>
          <a href="#estudio">Estudio</a>
          <a href="#servicios">Servicios</a>
          <a href="#contacto">Contacto</a>
        </nav>

        <h1 class="hero__identity">
          <span class="hero__logo-reveal">
            <img class="hero__logo" src={`${base}arqax-logo.svg`} alt="ARQAX Arquitectura" />
          </span>
        </h1>

        <div class="hero__copy">
          <p class="hero__copy-reveal hero__disciplines">
            <span class="hero__pair">
              <span>Arquitectura</span>
              <i aria-hidden="true"></i>
              <span>Interiorismo</span>
            </span>
            <i class="hero__pair-sep" aria-hidden="true"></i>
            <span class="hero__pair">
              <span>Espacios comerciales</span>
              <i aria-hidden="true"></i>
              <span>Mobiliario de lujo</span>
            </span>
          </p>
        </div>

        <div class="scroll-cue" aria-hidden="true">
          <span>Descubre</span>
          <i></i>
        </div>
      </div>
    </section>

    <section class="next-chapter" id="proyectos">
      <header class="next-chapter__head">
        <p>ARQAX · Arquitectura</p>
        <h2>Proyectos destacados</h2>
      </header>

      <div class="work-index">
        {
          projects.map((project, index) => (
            <article
              class:list={["work", "reveal", { "work--flip": index % 2 === 1 }]}
            >
              <a class="work__link" href={projectUrl(project)}>
                <figure class="work__media">
                  <img
                    transition:name={`hero-${project.slug}`}
                    src={shotSrc(project.slug, project.hero, 0)}
                    srcset={shotSrcset(project.slug, project.hero)}
                    sizes="(max-width: 820px) 100vw, 45rem"
                    alt={project.hero.alt}
                    width={project.hero.size[0]}
                    height={project.hero.size[1]}
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />
                </figure>

                <div class="work__label">
                  <p class="work__index">{String(index + 1).padStart(2, "0")}</p>
                  <h3 class="work__name" transition:name={`title-${project.slug}`}>
                    {project.name}
                  </h3>
                  <p class="work__type">{project.type}</p>
                  <span class="work__cta">
                    Ver proyecto <span aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="value" id="estudio">
      <div class="value__inner">
        <header class="value__head reveal">
          <p class="value__eyebrow">Estudio</p>
          <h2 class="value__title">Arquitectura comercial y retail</h2>
          <p class="value__lead">
            ARQAX es una empresa de Grupo IAGO especializada en arquitectura
            comercial y retail, que desarrolla espacios funcionales, estéticos
            y estratégicos para las marcas. Participamos en todo el proceso:
            desde el diseño conceptual y el proyecto ejecutivo hasta la
            ejecución de obra y la fabricación de mobiliario, ofreciendo una
            solución integral para nuestros clientes.
          </p>
        </header>

        <div class="value__grid reveal">
          <div class="value__synergy">
            <p class="value__kicker">Propuesta de valor</p>
            <p class="value__copy">
              Acompañamos a nuestros clientes durante todo el ciclo del
              proyecto. No solo diseñamos: coordinamos, ejecutamos y entregamos
              espacios listos para operar, asegurando calidad, control y
              continuidad en cada etapa.
            </p>
          </div>

          <div class="value__synergy">
            <p class="value__kicker">Sinergia</p>
            <img
              class="value__iago"
              src={`${base}grupo-iago.png`}
              alt="Grupo IAGO"
              width="369"
              height="155"
              loading="lazy"
              decoding="async"
            />
            <p class="value__copy">
              Nuestra mayor fortaleza es la sinergia con las empresas que
              conforman Grupo IAGO: integramos en un mismo proyecto
              arquitectura, proyecto ejecutivo, construcción, fabricación de
              mobiliario y soluciones especializadas, desde el primer trazo
              hasta la entrega final.
            </p>
            <p class="value__disciplines">
              Diseño · Arquitectura · Interiorismo · Fabricación ·
              Construcción · Lujo
            </p>
          </div>
        </div>

        <ul class="value__benefits reveal">
          <li>
            <p class="value__benefit-index">01</p>
            <h3>Un solo interlocutor</h3>
            <p>
              Reducimos la coordinación entre múltiples proveedores y
              mantenemos una responsabilidad clara de principio a fin.
            </p>
          </li>
          <li>
            <p class="value__benefit-index">02</p>
            <h3>Tiempos optimizados</h3>
            <p>
              Las etapas se traslapan y se resuelven en conjunto, sin las
              esperas que impone trabajar con equipos desconectados.
            </p>
          </li>
          <li>
            <p class="value__benefit-index">03</p>
            <h3>Control de calidad</h3>
            <p>
              Supervisamos cada entrega con los mismos estándares, desde el
              proyecto ejecutivo hasta el último detalle de mobiliario.
            </p>
          </li>
          <li>
            <p class="value__benefit-index">04</p>
            <h3>Ejecución fiel al diseño</h3>
            <p>
              Lo que se dibuja es lo que se construye: la intención del
              proyecto se preserva hasta la entrega final.
            </p>
          </li>
        </ul>
      </div>
    </section>

    <section class="services" id="servicios">
      <div class="services__inner">
        <header class="services__head reveal">
          <p class="services__eyebrow">Servicios</p>
          <h2 class="services__title">Una solución integral</h2>
        </header>

        <ol class="services__list reveal">
          <li>
            <span class="services__index">01</span>
            <span class="services__name">Arquitectura comercial y retail</span>
          </li>
          <li>
            <span class="services__index">02</span>
            <span class="services__name">Diseño arquitectónico e interiorismo</span>
          </li>
          <li>
            <span class="services__index">03</span>
            <span class="services__name">Proyecto ejecutivo</span>
          </li>
          <li>
            <span class="services__index">04</span>
            <span class="services__name">
              Remodelaciones y adecuaciones comerciales
            </span>
          </li>
          <li>
            <span class="services__index">05</span>
            <span class="services__name">Ejecución y supervisión de obra</span>
          </li>
          <li>
            <span class="services__index">06</span>
            <span class="services__name">
              Fabricación e instalación de mobiliario
              <span class="services__note">
                a través de IAGO Design, empresa de Grupo IAGO
              </span>
            </span>
          </li>
          <li>
            <span class="services__index">07</span>
            <span class="services__name">
              Coordinación integral de proyectos
              <span class="services__note">llave en mano</span>
            </span>
          </li>
        </ol>
      </div>
    </section>

    <section class="philosophy" aria-label="Filosofía">
      <div class="philosophy__inner reveal">
        <p class="philosophy__eyebrow">Filosofía</p>
        <blockquote class="philosophy__quote">
          Un espacio comercial debe vender, comunicar y generar experiencias.
        </blockquote>
        <p class="philosophy__copy">
          Diseñamos con una visión estratégica donde cada decisión responde a un
          objetivo de negocio, cuidando tanto la funcionalidad como la calidad
          estética y constructiva.
        </p>
      </div>
    </section>

    <section class="contact" id="contacto">
      <div class="contact__inner reveal">
        <div class="contact__intro">
          <p class="contact__eyebrow">Contacto</p>
          <h2 class="contact__title">Hablemos de tu próximo proyecto</h2>
          <p class="contact__lead">
            Cuéntanos tu idea y agendemos una primera conversación. Cada espacio
            comienza con un diálogo.
          </p>
          <p class="contact__note">Respondemos en 24 – 48 horas</p>
        </div>

        <form class="contact__form" id="contact-form" novalidate>
          <!-- Web3Forms: reemplaza el valor por tu access key de https://web3forms.com -->
          <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
          <input type="hidden" name="subject" value="Nuevo mensaje de contacto — ARQAX" />
          <input type="hidden" name="from_name" value="ARQAX Arquitectura" />
          <input
            type="checkbox"
            name="botcheck"
            class="contact__honeypot"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <div class="field">
            <label for="cf-name">Nombre</label>
            <input
              id="cf-name"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder="Tu nombre"
            />
          </div>

          <div class="field">
            <label for="cf-email">Correo electrónico</label>
            <input
              id="cf-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="tu@correo.com"
            />
          </div>

          <div class="field">
            <label for="cf-phone">
              Teléfono <span class="field__opt">(opcional)</span>
            </label>
            <input
              id="cf-phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              placeholder="+52 55 0000 0000"
            />
          </div>

          <div class="field">
            <label for="cf-message">Mensaje</label>
            <textarea
              id="cf-message"
              name="message"
              rows="4"
              required
              placeholder="Cuéntanos sobre tu proyecto…"></textarea>
          </div>

          <button type="submit" class="contact__submit">Enviar mensaje</button>
          <p class="contact__status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="site-footer__top reveal">
      <div class="site-footer__brand">
        <p class="site-footer__wordmark">ARQAX</p>
        <p class="site-footer__tagline">
          Arquitectura comercial y retail. Diseño, proyecto ejecutivo, obra y
          mobiliario en una sola solución.
        </p>
        <div class="site-footer__group">
          <p class="site-footer__group-label">Una empresa de</p>
          <img
            class="site-footer__group-logo"
            src={`${base}grupo-iago.png`}
            alt="Grupo IAGO"
            width="369"
            height="155"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <nav class="site-footer__col" aria-label="Navegación del pie de página">
        <p class="site-footer__heading">Navegación</p>
        <a href="#proyectos">Proyectos</a>
        <a href="#estudio">Estudio</a>
        <a href="#servicios">Servicios</a>
        <a href="#contacto">Contacto</a>
      </nav>

      <div class="site-footer__col">
        <p class="site-footer__heading">Síguenos</p>
        <!-- Reemplaza href="#" por las URLs reales de las redes -->
        <a href="#" rel="noopener">Instagram</a>
        <a href="#" rel="noopener">LinkedIn</a>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} ARQAX Arquitectura · Todos los derechos reservados</p>
      <a href="#top" class="site-footer__totop">Volver arriba ↑</a>
    </div>
  </footer>
</Base>

