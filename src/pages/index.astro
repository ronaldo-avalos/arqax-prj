---
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();

type Shot = {
  slug: string;
  caption: string;
  alt: string;
  widths: [number, number];
  size: [number, number];
  /** Ocupa las dos columnas de la retícula */
  full?: boolean;
  /** Normaliza el encuadre (recorte al centro) para que la fila cuadre */
  ratio?: string;
};

type Project = {
  slug: string;
  name: string;
  copy: string;
  meta: [string, string][];
  hero: Shot;
  gallery: Shot[];
};

// Las galerías se arman por pares del mismo formato para que cada fila
// cuadre sin recortar; los pares dispares se normalizan con `ratio`.
const projects: Project[] = [
  {
    slug: "smart-bamboo",
    name: "Smart Bamboo",
    copy: "Una tienda concebida como una experiencia de descanso. Los volúmenes curvos y los nichos iluminados ordenan el recorrido y ponen el producto en el centro, mientras la luz perimetral define cada zona y da continuidad al espacio, de la vitrina a la última área de prueba.",
    meta: [
      ["Tipología", "Retail · Tienda"],
      ["Alcance", "Diseño, proyecto ejecutivo, obra y mobiliario"],
      ["Servicios", "Arquitectura comercial, interiorismo y fabricación"],
    ],
    hero: {
      slug: "fachada-frontal",
      caption: "Fachada y vitrina principal",
      alt: "Fachada de la tienda Smart Bamboo con letrero luminoso y vitrina iluminada",
      widths: [1200, 1672],
      size: [1672, 941],
    },
    gallery: [
      {
        slug: "zona-descanso",
        caption: "Área de exhibición y descanso",
        alt: "Interior de Smart Bamboo con camas de exhibición y luz perimetral",
        widths: [900, 1500],
        size: [1500, 844],
      },
      {
        slug: "muro-marca",
        caption: "Muro de marca y zona de prueba",
        alt: "Muro de marca con iconografía, sillones de masaje y cama de prueba",
        widths: [900, 1500],
        size: [1500, 844],
      },
      {
        slug: "dormitorio-nicho",
        caption: "Nicho de descanso",
        alt: "Cama enmarcada por un nicho curvo con luz perimetral",
        widths: [700, 1100],
        size: [1100, 1956],
      },
      {
        slug: "exhibicion",
        caption: "Mobiliario a medida",
        alt: "Mueble curvo a medida con exhibición de textiles",
        widths: [700, 1100],
        size: [1100, 1956],
      },
      {
        slug: "camas-vitrina",
        caption: "Vitrina interior",
        alt: "Camas de exhibición junto al cristal de la vitrina",
        widths: [900, 1500],
        size: [1500, 844],
      },
      {
        slug: "fachada-esquina",
        caption: "Acceso en esquina",
        alt: "Fachada en esquina de Smart Bamboo iluminada de noche",
        widths: [900, 1500],
        size: [1500, 844],
      },
    ],
  },
  {
    slug: "papi-steak",
    name: "Papi Steak",
    copy: "Un steakhouse resuelto como un salón nocturno. El terciopelo, el latón y el cortinaje envuelven el comedor mientras los candiles de flecos bajan la escala del techo y concentran la luz sobre cada mesa. El mobiliario a medida ordena banquetas y reservados en un recorrido continuo.",
    meta: [
      ["Tipología", "Hospitalidad · Restaurante"],
      ["Alcance", "Diseño, proyecto ejecutivo, obra y mobiliario"],
      ["Servicios", "Interiorismo, fabricación e instalación"],
    ],
    hero: {
      slug: "salon-principal",
      caption: "Salón principal",
      alt: "Comedor principal de Papi Steak con candiles de flecos y muro floral iluminado",
      widths: [1200, 1800],
      size: [1800, 1200],
    },
    gallery: [
      {
        slug: "banquetas",
        caption: "Banquetas y comedor",
        alt: "Hilera de banquetas de terciopelo rojo con mesas vestidas",
        widths: [1200, 1800],
        size: [1800, 1009],
        full: true,
      },
      {
        slug: "reservado-floral",
        caption: "Reservado con muro floral",
        alt: "Reservado con muro floral y banqueta de terciopelo rojo",
        widths: [700, 1100],
        size: [1100, 1382],
      },
      {
        slug: "candil-espejo",
        caption: "Candil y espejo",
        alt: "Candil de flecos sobre mesas vestidas frente a un muro espejado",
        widths: [700, 1100],
        size: [1100, 1355],
      },
      {
        slug: "servicio-mesa",
        caption: "Servicio de mesa",
        alt: "Detalle del servicio de mesa sobre cubierta laqueada con canto de latón",
        widths: [700, 1100],
        size: [1100, 1375],
        ratio: "4 / 5",
      },
      {
        slug: "cortinaje-espejo",
        caption: "Cortinaje y espejo de latón",
        alt: "Cortinaje de terciopelo con espejo de latón y mesa vestida",
        widths: [700, 1100],
        size: [1100, 1375],
        ratio: "4 / 5",
      },
    ],
  },
];

const src = (project: string, shot: Shot, i: number) =>
  `${base}projects/${project}/${shot.slug}-${shot.widths[i]}.webp`;

const srcset = (project: string, shot: Shot) =>
  shot.widths
    .map((w) => `${base}projects/${project}/${shot.slug}-${w}.webp ${w}w`)
    .join(", ");
---

<Base>
  <main id="top">
    <section class="hero" aria-label="ARQAX Arquitectura">
      <div class="hero__stage">
        <div class="hero__canvas hero__canvas--back" aria-hidden="true">
          <img class="hero__back" src={`${base}hero-back.png`} alt="" draggable="false" />
        </div>

        <div class="hero__canvas hero__canvas--front" aria-hidden="true">
          <img class="hero__front" src={`${base}hero-front.png`} alt="" draggable="false" />
        </div>

        <div class="hero__shade" aria-hidden="true"></div>

        <nav class="hero-nav" aria-label="Navegación principal">
          <a href="#proyectos">Proyectos</a>
          <a href="#estudio">Estudio</a>
          <a href="#servicios">Servicios</a>
          <a href="#contacto">Contacto</a>
        </nav>

        <div class="hero__identity">
          <span class="hero__logo-reveal">
            <img class="hero__logo" src={`${base}arqax-logo.svg`} alt="ARQAX Arquitectura" />
          </span>
        </div>

        <div class="hero__copy">
          <div class="hero__copy-reveal">
            <h1>Diseños que impactan</h1>
            <p>
              Estudio de arquitectura. Identidad que construye confianza, diseña
              experiencias y transforma espacios.
            </p>
          </div>
        </div>

        <div class="scroll-cue" aria-hidden="true">
          <span>Descubre</span>
          <i></i>
        </div>
      </div>
    </section>

    <section class="next-chapter" id="proyectos">
      <header class="next-chapter__head">
        <p>ARQAX · Arquitectura</p>
        <h2>Proyectos destacados</h2>
      </header>

      <!-- Confirmar con el cliente: ubicación, superficie, año y alcance real de cada proyecto -->
      {
        projects.map((project, index) => (
          <article class="project">
            <figure class="shot shot--hero reveal">
              <button
                type="button"
                class="shot__btn"
                data-full={src(project.slug, project.hero, 1)}
                data-caption={`${project.name} — ${project.hero.caption}`}
              >
                <img
                  src={src(project.slug, project.hero, 0)}
                  srcset={srcset(project.slug, project.hero)}
                  sizes="(max-width: 78rem) 100vw, 78rem"
                  alt={project.hero.alt}
                  width={project.hero.size[0]}
                  height={project.hero.size[1]}
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
              </button>
              <figcaption>{project.hero.caption}</figcaption>
            </figure>

            <div class="project__body reveal">
              <div class="project__intro">
                <p class="project__eyebrow">
                  Proyecto {String(index + 1).padStart(2, "0")}
                </p>
                <h3 class="project__name">{project.name}</h3>
                <p class="project__copy">{project.copy}</p>
              </div>

              <dl class="project__meta">
                {project.meta.map(([term, value]) => (
                  <div>
                    <dt>{term}</dt>
                    <dd>{value}</dd>
                  </div>
                ))}
              </dl>
            </div>

            <div class="project__gallery">
              {project.gallery.map((shot) => (
                <figure class:list={["shot", "reveal", { "shot--full": shot.full }]}>
                  <button
                    type="button"
                    class="shot__btn"
                    data-full={src(project.slug, shot, 1)}
                    data-caption={`${project.name} — ${shot.caption}`}
                  >
                    <img
                      src={src(project.slug, shot, 0)}
                      srcset={srcset(project.slug, shot)}
                      sizes={
                        shot.full
                          ? "(max-width: 78rem) 100vw, 78rem"
                          : "(max-width: 60rem) 100vw, 39rem"
                      }
                      alt={shot.alt}
                      width={shot.size[0]}
                      height={shot.size[1]}
                      style={shot.ratio ? `aspect-ratio: ${shot.ratio}` : undefined}
                      class:list={{ "shot__img--cover": shot.ratio }}
                      loading="lazy"
                      decoding="async"
                    />
                  </button>
                  <figcaption>{shot.caption}</figcaption>
                </figure>
              ))}
            </div>
          </article>
        ))
      }
    </section>

    <dialog class="lightbox" id="lightbox" aria-label="Imagen ampliada">
      <div class="lightbox__inner">
        <img class="lightbox__img" src="" alt="" />
        <p class="lightbox__caption"></p>
      </div>
      <button type="button" class="lightbox__close" aria-label="Cerrar imagen">
        ✕
      </button>
    </dialog>
    <section class="value" id="estudio">
      <div class="value__inner">
        <header class="value__head reveal">
          <p class="value__eyebrow">Estudio</p>
          <h2 class="value__title">Arquitectura comercial y retail</h2>
          <p class="value__lead">
            ARQAX es una empresa de Grupo IAGO especializada en arquitectura
            comercial y retail, que desarrolla espacios funcionales, estéticos
            y estratégicos para las marcas. Participamos en todo el proceso:
            desde el diseño conceptual y el proyecto ejecutivo hasta la
            ejecución de obra y la fabricación de mobiliario, ofreciendo una
            solución integral para nuestros clientes.
          </p>
        </header>

        <div class="value__grid reveal">
          <div class="value__synergy">
            <p class="value__kicker">Propuesta de valor</p>
            <p class="value__copy">
              Acompañamos a nuestros clientes durante todo el ciclo del
              proyecto. No solo diseñamos: coordinamos, ejecutamos y entregamos
              espacios listos para operar, asegurando calidad, control y
              continuidad en cada etapa.
            </p>
          </div>

          <div class="value__synergy">
            <p class="value__kicker">Sinergia</p>
            <img
              class="value__iago"
              src={`${base}grupo-iago.png`}
              alt="Grupo IAGO"
              width="369"
              height="155"
              loading="lazy"
              decoding="async"
            />
            <p class="value__copy">
              Nuestra mayor fortaleza es la sinergia con las empresas que
              conforman Grupo IAGO: integramos en un mismo proyecto
              arquitectura, proyecto ejecutivo, construcción, fabricación de
              mobiliario y soluciones especializadas, desde el primer trazo
              hasta la entrega final.
            </p>
            <p class="value__disciplines">
              Diseño · Arquitectura · Interiorismo · Fabricación ·
              Construcción · Lujo
            </p>
          </div>
        </div>

        <ul class="value__benefits reveal">
          <li>
            <p class="value__benefit-index">01</p>
            <h3>Un solo interlocutor</h3>
            <p>
              Reducimos la coordinación entre múltiples proveedores y
              mantenemos una responsabilidad clara de principio a fin.
            </p>
          </li>
          <li>
            <p class="value__benefit-index">02</p>
            <h3>Tiempos optimizados</h3>
            <p>
              Las etapas se traslapan y se resuelven en conjunto, sin las
              esperas que impone trabajar con equipos desconectados.
            </p>
          </li>
          <li>
            <p class="value__benefit-index">03</p>
            <h3>Control de calidad</h3>
            <p>
              Supervisamos cada entrega con los mismos estándares, desde el
              proyecto ejecutivo hasta el último detalle de mobiliario.
            </p>
          </li>
          <li>
            <p class="value__benefit-index">04</p>
            <h3>Ejecución fiel al diseño</h3>
            <p>
              Lo que se dibuja es lo que se construye: la intención del
              proyecto se preserva hasta la entrega final.
            </p>
          </li>
        </ul>
      </div>
    </section>

    <section class="services" id="servicios">
      <div class="services__inner">
        <header class="services__head reveal">
          <p class="services__eyebrow">Servicios</p>
          <h2 class="services__title">Una solución integral</h2>
        </header>

        <ol class="services__list reveal">
          <li>
            <span class="services__index">01</span>
            <span class="services__name">Arquitectura comercial y retail</span>
          </li>
          <li>
            <span class="services__index">02</span>
            <span class="services__name">Diseño arquitectónico e interiorismo</span>
          </li>
          <li>
            <span class="services__index">03</span>
            <span class="services__name">Proyecto ejecutivo</span>
          </li>
          <li>
            <span class="services__index">04</span>
            <span class="services__name">
              Remodelaciones y adecuaciones comerciales
            </span>
          </li>
          <li>
            <span class="services__index">05</span>
            <span class="services__name">Ejecución y supervisión de obra</span>
          </li>
          <li>
            <span class="services__index">06</span>
            <span class="services__name">
              Fabricación e instalación de mobiliario
              <span class="services__note">
                a través de IAGO Design, empresa de Grupo IAGO
              </span>
            </span>
          </li>
          <li>
            <span class="services__index">07</span>
            <span class="services__name">
              Coordinación integral de proyectos
              <span class="services__note">llave en mano</span>
            </span>
          </li>
        </ol>
      </div>
    </section>

    <section class="philosophy" aria-label="Filosofía">
      <div class="philosophy__inner reveal">
        <p class="philosophy__eyebrow">Filosofía</p>
        <blockquote class="philosophy__quote">
          Un espacio comercial debe vender, comunicar y generar experiencias.
        </blockquote>
        <p class="philosophy__copy">
          Diseñamos con una visión estratégica donde cada decisión responde a un
          objetivo de negocio, cuidando tanto la funcionalidad como la calidad
          estética y constructiva.
        </p>
      </div>
    </section>

    <section class="contact" id="contacto">
      <div class="contact__inner reveal">
        <div class="contact__intro">
          <p class="contact__eyebrow">Contacto</p>
          <h2 class="contact__title">Hablemos de tu próximo proyecto</h2>
          <p class="contact__lead">
            Cuéntanos tu idea y agendemos una primera conversación. Cada espacio
            comienza con un diálogo.
          </p>
          <p class="contact__note">Respondemos en 24 – 48 horas</p>
        </div>

        <form class="contact__form" id="contact-form" novalidate>
          <!-- Web3Forms: reemplaza el valor por tu access key de https://web3forms.com -->
          <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
          <input type="hidden" name="subject" value="Nuevo mensaje de contacto — ARQAX" />
          <input type="hidden" name="from_name" value="ARQAX Arquitectura" />
          <input
            type="checkbox"
            name="botcheck"
            class="contact__honeypot"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <div class="field">
            <label for="cf-name">Nombre</label>
            <input
              id="cf-name"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder="Tu nombre"
            />
          </div>

          <div class="field">
            <label for="cf-email">Correo electrónico</label>
            <input
              id="cf-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="tu@correo.com"
            />
          </div>

          <div class="field">
            <label for="cf-phone">
              Teléfono <span class="field__opt">(opcional)</span>
            </label>
            <input
              id="cf-phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              placeholder="+52 55 0000 0000"
            />
          </div>

          <div class="field">
            <label for="cf-message">Mensaje</label>
            <textarea
              id="cf-message"
              name="message"
              rows="4"
              required
              placeholder="Cuéntanos sobre tu proyecto…"></textarea>
          </div>

          <button type="submit" class="contact__submit">Enviar mensaje</button>
          <p class="contact__status" role="status" aria-live="polite"></p>
        </form>
      </div>
