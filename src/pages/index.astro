  </main>

  <footer class="site-footer">
    <div class="site-footer__top reveal">
      <div class="site-footer__brand">
        <p class="site-footer__wordmark">ARQAX</p>
        <p class="site-footer__tagline">
          Arquitectura comercial y retail. Diseño, proyecto ejecutivo, obra y
          mobiliario en una sola solución.
        </p>
        <div class="site-footer__group">
          <p class="site-footer__group-label">Una empresa de</p>
          <img
            class="site-footer__group-logo"
            src={`${base}grupo-iago.png`}
            alt="Grupo IAGO"
            width="369"
            height="155"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <nav class="site-footer__col" aria-label="Navegación del pie de página">
        <p class="site-footer__heading">Navegación</p>
        <a href="#proyectos">Proyectos</a>
        <a href="#estudio">Estudio</a>
        <a href="#servicios">Servicios</a>
        <a href="#contacto">Contacto</a>
      </nav>

      <div class="site-footer__col">
        <p class="site-footer__heading">Síguenos</p>
        <!-- Reemplaza href="#" por las URLs reales de las redes -->
        <a href="#" rel="noopener">Instagram</a>
        <a href="#" rel="noopener">LinkedIn</a>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} ARQAX Arquitectura · Todos los derechos reservados</p>
      <a href="#top" class="site-footer__totop">Volver arriba ↑</a>
    </div>
  </footer>
</Base>

<script>
  const clamp = (value: number, min: number, max: number) =>
    Math.min(Math.max(value, min), max);

  const hero = document.querySelector<HTMLElement>(".hero");

  if (hero) {
    let frame = 0;

    const updateProgress = () => {
      frame = 0;
      const rect = hero.getBoundingClientRect();
      const scrollableDistance = Math.max(rect.height - window.innerHeight, 1);
      const progress = clamp(-rect.top / scrollableDistance, 0, 1);
      hero.style.setProperty("--scroll-progress", progress.toFixed(4));
    };

    const requestUpdate = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(updateProgress);
    };

    updateProgress();
    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate);
  }

  // Reveal-on-scroll for elements marked with .reveal
  const revealTargets = document.querySelectorAll<HTMLElement>(".reveal");
  if (revealTargets.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.18 },
    );
    revealTargets.forEach((el) => io.observe(el));
  }

  // Lightbox de proyecto
  const lightbox = document.querySelector<HTMLDialogElement>("#lightbox");

  if (lightbox) {
    const lbImg = lightbox.querySelector<HTMLImageElement>(".lightbox__img");
    const lbCaption = lightbox.querySelector<HTMLElement>(".lightbox__caption");
    const lbClose = lightbox.querySelector<HTMLButtonElement>(
      ".lightbox__close",
    );

    const lbInner = lightbox.querySelector<HTMLElement>(".lightbox__inner");

    document.querySelectorAll<HTMLButtonElement>(".shot__btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const full = btn.dataset.full;
        const caption = btn.dataset.caption ?? "";
        const img = btn.querySelector("img");
        if (!full || !lbImg || lightbox.open) return;

        lbImg.src = full;
        lbImg.alt = img?.alt ?? caption;
        if (lbCaption) lbCaption.textContent = caption;
        lightbox.showModal();
        document.body.classList.add("has-lightbox");
      });
    });

    lbClose?.addEventListener("click", () => lightbox.close());

    // Tocar fuera de la imagen cierra (el diálogo cubre todo el viewport)
    lbInner?.addEventListener("click", (event) => {
      if (event.target !== lbImg) lightbox.close();
    });

    lightbox.addEventListener("close", () => {
      document.body.classList.remove("has-lightbox");
      if (lbImg) lbImg.removeAttribute("src");
    });
  }

  // Contact form → Web3Forms (AJAX)
  const form = document.querySelector<HTMLFormElement>("#contact-form");

  if (form) {
    const status = form.querySelector<HTMLParagraphElement>(".contact__status");
    const submit = form.querySelector<HTMLButtonElement>(
      "button[type=submit]",
    );

    const setStatus = (message: string, state: string) => {
      if (!status) return;
      status.textContent = message;
      status.className = `contact__status is-${state}`;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const accessKey = (
        form.querySelector<HTMLInputElement>("[name=access_key]")?.value ?? ""
      ).trim();
      if (!accessKey || accessKey === "YOUR_WEB3FORMS_ACCESS_KEY") {
        setStatus(
          "El formulario aún no está configurado. Falta la access key de Web3Forms.",
          "error",
        );
        return;
      }

      if (submit) submit.disabled = true;
      setStatus("Enviando…", "sending");

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
        });
        const result = await response.json();

        if (response.ok && result.success) {
          setStatus(
            "¡Gracias! Tu mensaje fue enviado. Te responderemos pronto.",
            "success",
          );
          form.reset();
        } else {
          setStatus(
            result.message ?? "No se pudo enviar. Inténtalo de nuevo.",
            "error",
          );
        }
      } catch {
        setStatus(
          "Error de conexión. Inténtalo de nuevo más tarde.",
          "error",
        );
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  }
</script>
