---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ARQAX Arquitectura",
  description = "Arquitectura comercial y retail. Empresa de Grupo IAGO: diseño conceptual, proyecto ejecutivo, ejecución de obra y fabricación de mobiliario en una solución integral.",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const ogImage = new URL(`${base}og.png`, Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);

// Número oficial de contacto: +52 56 2008 4317 (formato internacional,
// solo dígitos: código de país + número).
const whatsappNumber = "525620084317";
const whatsappMessage =
  "Hola ARQAX, me gustaría platicar sobre un proyecto.";
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Espacios sobrios, precisos y duraderos." />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1672" />
    <meta property="og:image:height" content="941" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content="Espacios sobrios, precisos y duraderos." />
    <meta name="twitter:image" content={ogImage} />

    <ClientRouter />
  </head>
  <body>
    <nav class="pill-nav" aria-label="Navegación fija">
      <a class="pill-nav__brand" href={base} aria-label="ARQAX — inicio">
        <img src={`${base}arqax-logo.svg`} alt="" width="92" height="24" />
      </a>
      <div class="pill-nav__links">
        <a href={`${base}#servicios`}>Servicios</a>
        <a href={`${base}#proyectos`}>Proyectos</a>
        <a href={`${base}#estudio`}>Estudio</a>
        <a href={`${base}#contacto`}>Contacto</a>
      </div>
    </nav>

    <slot />

    <a
      class="whatsapp-fab"
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Escríbenos por WhatsApp"
    >
      <span class="whatsapp-fab__label" aria-hidden="true">Escríbenos</span>
      <span class="whatsapp-fab__icon">
        <svg viewBox="0 0 32 32" role="img" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M16.03 4C9.42 4 4.05 9.37 4.05 15.98c0 2.11.55 4.17 1.6 5.99L4 28l6.19-1.61a11.94 11.94 0 0 0 5.84 1.49h.01c6.6 0 11.97-5.37 11.98-11.98a11.9 11.9 0 0 0-3.5-8.48A11.9 11.9 0 0 0 16.03 4Zm0 2.02c2.66 0 5.16 1.04 7.04 2.92a9.9 9.9 0 0 1 2.92 7.04c0 5.5-4.47 9.96-9.97 9.96a9.94 9.94 0 0 1-5.06-1.39l-.36-.21-3.67.96.98-3.58-.24-.37a9.9 9.9 0 0 1-1.52-5.3c0-5.49 4.47-9.96 9.97-9.96h-.09Zm-4.5 5.03c-.21 0-.55.08-.84.4-.29.32-1.1 1.08-1.1 2.63 0 1.55 1.13 3.05 1.29 3.26.16.21 2.19 3.34 5.3 4.68.74.32 1.32.51 1.77.66.74.24 1.42.2 1.96.12.6-.09 1.84-.75 2.1-1.48.26-.73.26-1.35.18-1.48-.08-.13-.29-.21-.6-.37-.32-.16-1.85-.91-2.14-1.02-.29-.1-.5-.16-.71.16-.21.32-.81 1.02-.99 1.23-.19.21-.37.24-.68.08-.32-.16-1.33-.49-2.53-1.56-.94-.83-1.57-1.86-1.75-2.17-.19-.32-.02-.49.14-.65.14-.14.32-.37.47-.56.16-.19.21-.32.32-.53.1-.21.05-.4-.03-.56-.08-.16-.7-1.7-.98-2.32-.26-.61-.52-.53-.71-.54h-.6Z"
          ></path>
        </svg>
      </span>
    </a>

    <script>
      const clamp = (value: number, min: number, max: number) =>
        Math.min(Math.max(value, min), max);

      // Parallax del hero — un solo listener global; el elemento se
      // consulta por frame porque cambia con cada navegación SPA.
      let frame = 0;

      // Umbral en el que la barra superior cede su lugar al header píldora.
      const PILL_AT = 88;

      const updateScrolledState = () => {
        document.documentElement.classList.toggle(
          "is-scrolled",
          window.scrollY > PILL_AT,
        );
      };

      const updateHeroProgress = () => {
        const hero = document.querySelector<HTMLElement>(".hero");
        if (!hero) return;
        const rect = hero.getBoundingClientRect();
        const scrollableDistance = Math.max(rect.height - window.innerHeight, 1);
        const progress = clamp(-rect.top / scrollableDistance, 0, 1);
        hero.style.setProperty("--scroll-progress", progress.toFixed(4));
      };

      const onFrame = () => {
        frame = 0;
        updateScrolledState();
        updateHeroProgress();
      };

      const requestFrame = () => {
        if (frame) return;
        frame = window.requestAnimationFrame(onFrame);
      };

      window.addEventListener("scroll", requestFrame, { passive: true });
      window.addEventListener("resize", requestFrame);

      // ClientRouter reemplaza los atributos de <html> al navegar: se repone
      // el estado antes del primer pintado para evitar un parpadeo.
      document.addEventListener("astro:after-swap", updateScrolledState);

      // Reveal-on-scroll for elements marked with .reveal
      const initReveal = () => {
        const revealTargets = document.querySelectorAll<HTMLElement>(".reveal");
        if (!revealTargets.length) return;
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.18 },
        );
        revealTargets.forEach((el) => io.observe(el));
      };

      // Lightbox de proyecto
      const initLightbox = () => {
        const lightbox = document.querySelector<HTMLDialogElement>("#lightbox");
        if (!lightbox) return;

        const lbImg = lightbox.querySelector<HTMLImageElement>(".lightbox__img");
        const lbCaption = lightbox.querySelector<HTMLElement>(".lightbox__caption");
        const lbClose = lightbox.querySelector<HTMLButtonElement>(
          ".lightbox__close",
        );

        const lbInner = lightbox.querySelector<HTMLElement>(".lightbox__inner");

        document
          .querySelectorAll<HTMLButtonElement>(".shot__btn")
          .forEach((btn) => {
            btn.addEventListener("click", () => {
              const full = btn.dataset.full;
              const caption = btn.dataset.caption ?? "";
              const img = btn.querySelector("img");
              if (!full || !lbImg || lightbox.open) return;

              lbImg.src = full;
              lbImg.alt = img?.alt ?? caption;
              if (lbCaption) lbCaption.textContent = caption;
              lightbox.showModal();
              document.body.classList.add("has-lightbox");
            });
          });

        lbClose?.addEventListener("click", () => lightbox.close());

        // Tocar fuera de la imagen cierra (el diálogo cubre todo el viewport)
        lbInner?.addEventListener("click", (event) => {
          if (event.target !== lbImg) lightbox.close();
        });

        lightbox.addEventListener("close", () => {
          document.body.classList.remove("has-lightbox");
          if (lbImg) lbImg.removeAttribute("src");
        });
      };

      // Contact form → Web3Forms (AJAX)
      const initContactForm = () => {
        const form = document.querySelector<HTMLFormElement>("#contact-form");
        if (!form) return;

        const status = form.querySelector<HTMLParagraphElement>(
          ".contact__status",
        );
        const submit = form.querySelector<HTMLButtonElement>(
          "button[type=submit]",
        );

        const setStatus = (message: string, state: string) => {
          if (!status) return;
          status.textContent = message;
          status.className = `contact__status is-${state}`;
        };

        form.addEventListener("submit", async (event) => {
          event.preventDefault();

          if (!form.checkValidity()) {
            form.reportValidity();
            return;
          }

          const accessKey = (
            form.querySelector<HTMLInputElement>("[name=access_key]")?.value ??
            ""
          ).trim();
          if (!accessKey || accessKey === "YOUR_WEB3FORMS_ACCESS_KEY") {
            setStatus(
              "El formulario aún no está configurado. Falta la access key de Web3Forms.",
              "error",
            );
            return;
          }

          if (submit) submit.disabled = true;
          setStatus("Enviando…", "sending");

          try {
            const response = await fetch("https://api.web3forms.com/submit", {
              method: "POST",
              headers: { Accept: "application/json" },
              body: new FormData(form),
            });
            const result = await response.json();

            if (response.ok && result.success) {
              setStatus(
                "¡Gracias! Tu mensaje fue enviado. Te responderemos pronto.",
                "success",
              );
              form.reset();
            } else {
              setStatus(
                result.message ?? "No se pudo enviar. Inténtalo de nuevo.",
                "error",
              );
            }
          } catch {
            setStatus(
              "Error de conexión. Inténtalo de nuevo más tarde.",
              "error",
            );
          } finally {
            if (submit) submit.disabled = false;
          }
        });
      };

      // Se dispara en la carga inicial y tras cada navegación con ClientRouter
      document.addEventListener("astro:page-load", () => {
        onFrame();
        initReveal();
        initLightbox();
        initContactForm();
      });
    </script>
  </body>
</html>
